# Path-only access records omit recovery query tokens and referrers.
log_format finco_private '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

# Preserve the original HTTPS scheme from a trusted edge proxy such as
# Cloudflare Tunnel. Unknown/spoofed values fall back to Nginx's local scheme.
map $http_x_forwarded_proto $finco_forwarded_proto {
    default $scheme;
    https https;
}

map $uri $finco_recovery_cache_control {
    default "";
    /reset-password "no-store";
    /verify-email "no-store";
}

server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    add_header Cache-Control $finco_recovery_cache_control always;
    access_log /var/log/nginx/access.log finco_private;

    # Baseline browser hardening. CSP intentionally allows HTTPS provider
    # scripts/frames because bank-connect widgets are third-party surfaces;
    # frame-ancestors/object/base/form remain locked down.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" always;

    # API proxy to backend.
    location /api/ {
        resolver ${NGINX_RESOLVER} valid=5s;
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $finco_forwarded_proto;
    }

    # A service worker must be revalidated aggressively. Caching this file at
    # the CDN/browser layer can strand installed clients on an old app version.
    location = /sw.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Service-Worker-Allowed "/";
        try_files $uri =404;
    }

    # Keep install metadata fresh while still allowing normal conditional GETs.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # Vite emits content-hashed production assets here. They are safe to cache
    # essentially forever because a content change produces a new URL.
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Never cache index.html so new deployments are always picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # No error-log request URI for incoming recovery credentials.
    location ~ ^/(reset-password|verify-email)$ {
        error_log /dev/null;
        try_files /index.html =404;
    }

    # SPA fallback — serve index.html for all non-file routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
