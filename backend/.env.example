# Transactional email: development may leave unset. Production local auth
# requires TLS, authenticated SMTP and EMAIL_DELIVERY_REQUIRED=true.
# Brevo is the researched zero-cost recommendation; provider acceptance pending.
EMAIL_DELIVERY_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
SMTP_SSL_CA_FILE=
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_CONCURRENT_SENDS=4

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fincopilot
DATABASE_EXTERNAL_REQUIRED=false
DB_SSL_MODE=prefer
DB_SSL_CA_FILE=
DB_POOL_MODE=queue
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=900
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DB_PREPARED_STATEMENT_CACHE_SIZE=100
DB_APPLICATION_NAME=fincopilot
SECRET_KEY=change-me-in-production
# Independent data keys: required in production; inject through secret files.
# Before upgrading an existing database, put the OLD SECRET_KEY in
# LEGACY_DATA_KEYS, then follow docs/trust/FINCO_REVISION_1_16_V1.md.
CREDENTIAL_ENCRYPTION_KEY=
CORE_COPILOT_SIGNING_KEY=
LEGACY_DATA_KEYS=
DEBUG=true
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_OAUTH_REDIRECT_URI=http://localhost:5173/oauth/callback
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://localhost:6379/0
REDIS_EXTERNAL_REQUIRED=false
REDIS_TLS_REQUIRED=false
REDIS_AUTH_REQUIRED=false
REDIS_SSL_CA_FILE=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Brazilian Treasury bond prices. On by default; set to false to disable
# (e.g. to avoid the dependency on the Brazilian government CSV endpoint).
TESOURO_DIRETO_ENABLED=true

# Number of trusted reverse proxies in front of the backend (the bundled nginx
# frontend counts as 1). Rate limiting keys requests by client IP; leaving this
# at 0 in a proxied deployment means every client shares one rate-limit bucket.
TRUSTED_PROXY_HOPS=0

# Optional OIDC login (Authentik, Pocket ID, or standard OIDC providers)
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=OIDC
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Defaults to ${FRONTEND_URL}/api/auth/oidc/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
OIDC_AUTO_REGISTER=true
OIDC_REQUIRE_VERIFIED_EMAIL=true
# Set to false only with OIDC_ENABLED=true, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL configured
LOCAL_AUTH_ENABLED=true
OIDC_SYNC_ROLES=false
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_ROLES=
OIDC_WORKSPACE_ROLE_MAP=


# Billing / Razorpay (checkout stays fail-closed unless explicitly enabled)
BILLING_CHECKOUT_ENABLED=false
BILLING_OFFER_RESERVATION_TTL_SECONDS=600
BILLING_TAX_DISPLAY_MODE=unconfigured
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY_ID=
RAZORPAY_PLAN_PRO_ANNUAL_ID=
RAZORPAY_PLAN_MAX_MONTHLY_ID=
