# Required for local development. Production Compose does NOT read secret
# values from this file; use FINCOPILOT_SECRETS_DIR and the per-secret files
# documented in docs/trust/FINCO_PRODUCTION_SECRET_MANAGEMENT_V1.md.
SECRET_KEY=change-me-in-production
# Independent data keys: required in production; inject through secret files.
# Before upgrading an existing database, put the OLD SECRET_KEY in
# LEGACY_DATA_KEYS, then follow docs/trust/FINCO_REVISION_1_16_V1.md.
CREDENTIAL_ENCRYPTION_KEY=
CORE_COPILOT_SIGNING_KEY=
LEGACY_DATA_KEYS=

# Production-only secret directory (host path, never commit its contents).
# docker-compose.prod.yml mounts this directory read-only at /run/secrets.
# Prefer an absolute operator-owned path with restrictive filesystem permissions.
# FINCOPILOT_SECRETS_DIR=/srv/fincopilot/secrets

# PostgreSQL runtime
# -----------------------------------------------------------------------------
# Local development may use the bundled database. Production stores the real
# DATABASE_URL as /run/secrets/database_url (Compose) or DATABASE_URL in the
# operator-managed Kubernetes Secret; never commit that provider URL.
DATABASE_EXTERNAL_REQUIRED=false
DB_SSL_MODE=prefer
DB_SSL_CA_FILE=
DB_POOL_MODE=queue
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=900
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30
DB_STATEMENT_TIMEOUT_MS=30000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DB_PREPARED_STATEMENT_CACHE_SIZE=100
DB_APPLICATION_NAME=fincopilot
# Production: DATABASE_EXTERNAL_REQUIRED=true and preferably DB_SSL_MODE=verify-full.
# See docs/trust/FINCO_PRODUCTION_POSTGRESQL_V1.md.

# Razorpay — Standard Checkout (https://razorpay.com/docs/)
# Get your test credentials from: https://dashboard.razorpay.com/app/keys
# Enable test mode in the dashboard before using test keys.
# Leave empty to keep checkout disabled (BILLING_CHECKOUT_ENABLED defaults to false).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Frontend receives only the KEY_ID (never the KEY_SECRET).
VITE_RAZORPAY_KEY_ID=
# Explicitly enable checkout once keys are set. Default: false (fail-closed).
BILLING_CHECKOUT_ENABLED=false
# Server-side price reservation. Bounded to 120–1800 seconds.
BILLING_OFFER_RESERVATION_TTL_SECONDS=600
# Must be inclusive or exclusive before production paid checkout is enabled.
BILLING_TAX_DISPLAY_MODE=unconfigured

# Razorpay base recurring Plan IDs. Provision/verify explicitly with:
#   cd backend && python scripts/razorpay_catalog.py --provision
# Test and Live environments use different IDs.
RAZORPAY_PLAN_PRO_MONTHLY_ID=
RAZORPAY_PLAN_PRO_ANNUAL_ID=
RAZORPAY_PLAN_MAX_MONTHLY_ID=

# Operator / business identity
# -----------------------------------------------------------------------------
# Canonical public identity for the service operator. Keep truthful: the
# current launch posture is an individual operator in India, not an
# incorporated company. Do not add a legal name unless the operator explicitly
# intends to publish it.
OPERATOR_IDENTITY_ENABLED=true
OPERATOR_BRAND_NAME=FinCo-Pilot
OPERATOR_ENTITY_TYPE=individual
OPERATOR_COUNTRY_CODE=IN
OPERATOR_LEGAL_NAME=

# Customer support / trust layer
# -----------------------------------------------------------------------------
# Keep this separate from SMTP_FROM_EMAIL. SUPPORT_EMAIL is the human help
# destination; transactional SMTP is used for password reset/verification.
#
# Zero-cost launch path: create a Zoho Desk India portal, use its default
# support address/portal, then configure the least-privilege OAuth integration
# with Desk.tickets.CREATE. Do not commit real OAuth credentials.
SUPPORT_ENABLED=false
SUPPORT_EMAIL=
SUPPORT_PORTAL_URL=
SUPPORT_HELP_CENTER_URL=
# Security reports stay separate from ordinary customer support.
SUPPORT_SECURITY_URL=https://github.com/S2zxx0zxx/FinCo-pilot/security/advisories/new
SUPPORT_PROVIDER=external
SUPPORT_TICKET_SUBMISSION_ENABLED=false
SUPPORT_RATE_LIMIT_PER_HOUR=6
# India data-center defaults. The runtime still honors Zoho's api_domain from
# the OAuth token response after validating that it is a Zoho Desk HTTPS host.
ZOHO_DESK_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_DESK_API_DOMAIN=https://desk.zoho.in
ZOHO_DESK_ORG_ID=
ZOHO_DESK_DEPARTMENT_ID=
ZOHO_DESK_CLIENT_ID=
ZOHO_DESK_CLIENT_SECRET=
ZOHO_DESK_REFRESH_TOKEN=


# Production Redis / Celery
# Development may use redis://localhost:6379/0. Production should write the
# authenticated REDIS_URL to the protected secret file named `redis_url`.
REDIS_URL=redis://localhost:6379/0
REDIS_EXTERNAL_REQUIRED=false
REDIS_TLS_REQUIRED=false
REDIS_AUTH_REQUIRED=false
REDIS_SSL_CA_FILE=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
CELERY_RESULT_EXPIRES_SECONDS=86400
CELERY_VISIBILITY_TIMEOUT_SECONDS=3600
CELERY_WORKER_PREFETCH_MULTIPLIER=1
# Production: external=true, tls=true, auth=true and REDIS_URL=rediss://...
# See docs/trust/FINCO_PRODUCTION_REDIS_WORKERS_V1.md.

# Object storage
# -----------------------------------------------------------------------------
# Development defaults to local disk. Roadmap #16 selects a private Cloudflare
# R2 bucket for production while keeping the runtime S3-compatible.
STORAGE_PROVIDER=local
REQUIRE_OBJECT_STORAGE=false
STORAGE_LOCAL_PATH=./data/attachments
STORAGE_S3_VENDOR=generic
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_PREFIX=fincopilot
STORAGE_S3_REQUEST_TIMEOUT_SECONDS=30
STORAGE_S3_PRESIGN_TTL_SECONDS=300
# Local development only. Production stores these values as
# /run/secrets/storage_s3_access_key and /run/secrets/storage_s3_secret_key.
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
# Production R2 shape:
# STORAGE_PROVIDER=s3
# REQUIRE_OBJECT_STORAGE=true
# STORAGE_S3_VENDOR=cloudflare_r2
# STORAGE_S3_REGION=auto
# STORAGE_S3_BUCKET=<private-bucket-name>
# STORAGE_S3_ENDPOINT_URL=https://<ACCOUNT_ID>[.<JURISDICTION>].r2.cloudflarestorage.com
# STORAGE_S3_PREFIX=fincopilot-prod
# Keep the bucket private; FinCo-Pilot downloads through authenticated backend
# paths and does not require a public r2.dev/custom-domain bucket.
# See docs/trust/FINCO_PRODUCTION_OBJECT_STORAGE_V1.md.

# Bank sync — Pluggy (https://pluggy.ai)
## 1. Create an account at https://dashboard.pluggy.ai
## 2. Copy your Client ID and Client Secret
## 3. Add http://localhost:${FRONTEND_PORT}/oauth/callback as an allowed redirect URI
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Bank sync — Enable Banking (https://enablebanking.com) for European banks
## 1. Sign up at https://enablebanking.com and create a Production application
## 2. Add http://localhost:${FRONTEND_PORT}/oauth/callback as an allowed redirect URL
## 3. Save the downloaded PEM file to ./secrets/enable_banking_private.pem
## 4. Copy your Application ID below
ENABLE_BANKING_APP_ID=
# Override only if you put the PEM somewhere other than the default below
# ENABLE_BANKING_PRIVATE_KEY_FILE=/app/secrets/enable_banking_private.pem
# Defaults to ${FRONTEND_URL}/oauth/callback. Set it only when the URL you
# registered in your EB application differs from where the app is served.
# ENABLE_BANKING_OAUTH_REDIRECT_URI=https://fincopilot.example.com/oauth/callback

# OIDC login (optional) — Authentik, Pocket ID, or any standard OIDC provider
## Redirect/callback URL to register in the provider:
##   http://localhost:${FRONTEND_PORT:-3000}/api/auth/oidc/callback
# OIDC_ENABLED=true
# OIDC_PROVIDER_NAME=Pocket ID
# OIDC_DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
# OIDC_CLIENT_ID=fincopilot
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_SCOPES=openid email profile
# OIDC_AUTO_REGISTER=true
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# Optional: require OIDC-only login; requires OIDC_ENABLED, OIDC_CLIENT_ID, and OIDC_DISCOVERY_URL
# Disables local login, registration, password reset/change, and new passkey ceremonies
# LOCAL_AUTH_ENABLED=false
# Link an OIDC login to an existing FinCo-Pilot account with the same email:
#   disabled (default) never links, verified_email links only when the provider
#   sends email_verified=true, email links on a matching email alone.
# OIDC_EXISTING_USER_LINK_MODE=disabled
# Optional: sync FinCo-Pilot admin/workspace roles from OIDC roles/groups
# OIDC_SYNC_ROLES=true
# OIDC_ROLES_CLAIM=groups
# OIDC_ADMIN_ROLES=fincopilot-admins
# OIDC_WORKSPACE_ROLE_MAP={"fincopilot-owners":"owner","fincopilot-editors":"editor","fincopilot-viewers":"viewer"}

# Brazilian Treasury bond lookup (Tesouro Direto). On by default; uncomment to
# disable (e.g. to avoid the dependency on the Brazilian government CSV endpoint).
# TESOURO_DIRETO_ENABLED=false

# Passkeys (optional) — nothing to set for the common cases.
## Passkeys follow the address you open the app on, so they work out of the box on
## http://localhost:3000 and on any HTTPS domain behind a reverse proxy.
##
## Two limits come from the WebAuthn standard itself, not from FinCo-Pilot:
##   - an IP address (http://192.168.1.10:3000) can never be used for passkeys
##   - plain HTTP can never be used, except on localhost
## Reach the app on a domain over HTTPS, or on http://localhost, to use passkeys.
##
## Set FRONTEND_URL when the app is served from a domain — it is also used for
## CORS and OAuth callbacks.
# FRONTEND_URL=https://fincopilot.example.com
##
## Optional: pin passkeys to a single domain. Leave unset to follow the browser.
## Set it to the parent domain if you reach the app on several subdomains.
# WEBAUTHN_RP_ID=fincopilot.example.com
## Optional: the name shown in the browser's passkey prompt.
# WEBAUTHN_RP_NAME=FinCo-Pilot

# Host ports (optional) — change these to avoid conflicts with other services
## Default values are set in docker-compose.yml and docker-compose.prod.yml.
## Example:
# FRONTEND_PORT=3132
# BACKEND_PORT=8182

# AI Agents (optional) — to enable, set BOTH:
#   1) the feature flag
#   2) COMPOSE_PROFILES so `docker compose up` starts the mcp-server container
#      (Docker Compose only. On a bare-metal/LXC install set just the flag,
#      run `uvicorn mcp_server.main:app --port 8765` next to the API, and set
#      AGENTS_BUILTIN_MCP_URL=http://127.0.0.1:8765/mcp)
# AGENTS_ENABLED=true
# COMPOSE_PROFILES=agents
# Public URL external agents use to reach the built-in MCP server, shown in the
# UI token panel. Leave unset to derive it from the browser (host:8765). Set it
# when the MCP server is exposed behind an ingress/reverse proxy on a custom
# host, subpath, or standard 80/443 port instead of :8765.
# AGENTS_EXTERNAL_MCP_URL=https://fincopilot.example.com/mcp

# FinCo-Pilot → OmniRoute gateway
# -----------------------------------------------------------------------------
# Recommended AI path for FinCo-Pilot:
#   FinCo backend → OmniRoute → vetted free-provider pool.
#
# "openai_compatible" below describes the HTTP wire format only. It does NOT
# require OpenAI or GPT. OmniRoute exposes an OpenAI-compatible /v1 endpoint
# while routing to the models/providers configured inside OmniRoute.
#
# Keep AGENTS_DEFAULT_MODEL pointed at a dedicated persisted combo containing
# ONLY providers/models you have explicitly approved for FinCo-Pilot. Do not
# use broad auto-routing in production if paid/provider connections are also
# present, because automatic routing can consider any eligible connection.
#
# Example production wiring:
# AGENTS_ENABLED=true
# Operational abuse/capacity ceiling for the built-in Copilot. This does not
# change the Advanced Agents pricing entitlement.
# AGENTS_CORE_COPILOT_DAILY_MESSAGES=50
# Per model round; protects latency/cost while keeping normal finance answers roomy.
# AGENTS_CORE_COPILOT_MAX_OUTPUT_TOKENS=1200
# AGENTS_DEFAULT_PROVIDER=openai_compatible
# AGENTS_DEFAULT_MODEL=fincopilot-free-smart
# AGENTS_OPENAI_COMPAT_BASE_URL=https://ai.example.com/v1
# AGENTS_OPENAI_COMPAT_API_KEY=replace-with-dedicated-omniroute-inference-key
#
# VPS deployment templates and exact setup steps:
#   deploy/omniroute/README.md