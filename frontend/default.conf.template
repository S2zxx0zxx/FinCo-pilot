# Path-only access records omit recovery query tokens and referrers.
log_format finco_private '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';

# Preserve the original HTTPS scheme from a trusted edge proxy such as
# Cloudflare Tunnel. Unknown/spoofed values fall back to Nginx's local scheme.
map $http_x_forwarded_proto $finco_forwarded_proto {
    default $scheme;
    https https;
}

map $request_uri $finco_recovery_cache_control {
    default "";
    ~^/(reset-password|verify-email)([?]|$) "no-store";
}

map $finco_forwarded_proto $finco_hsts {
    default "";
    https "max-age=31536000";
}

map "${FINCO_TRUSTED_TYPES_REPORT_ONLY}" $finco_tt_policy {
    default "";
    true "require-trusted-types-for 'script'";
}

server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    add_header Cache-Control $finco_recovery_cache_control always;
    access_log /var/log/nginx/access.log finco_private;

    include /etc/nginx/finco-security-headers.conf;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

    # API proxy to backend.
    location /api/ {
        include /etc/nginx/finco-security-headers.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        resolver ${NGINX_RESOLVER} valid=5s;
        set $upstream ${BACKEND_URL};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $finco_forwarded_proto;
    }

    # Same-origin MCP endpoint for Compose/Tunnel deployments. Resolve only
    # when called so optional agents do not block frontend startup.
    location = /mcp {
        include /etc/nginx/finco-security-headers.conf;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
        resolver ${NGINX_RESOLVER} valid=5s;
        set $mcp_upstream http://mcp-server:8765;
        proxy_pass $mcp_upstream;
        proxy_http_version 1.1;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $finco_forwarded_proto;
    }

    # A service worker must be revalidated aggressively. Caching this file at
    # the CDN/browser layer can strand installed clients on an old app version.
    location = /sw.js {
        include /etc/nginx/finco-security-headers.conf;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header Service-Worker-Allowed "/";
        try_files $uri =404;
    }

    # Keep install metadata fresh while still allowing normal conditional GETs.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        include /etc/nginx/finco-security-headers.conf;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    # Vite emits content-hashed production assets here. They are safe to cache
    # essentially forever because a content change produces a new URL.
    location ^~ /static/ {
        expires 1y;
        include /etc/nginx/finco-security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Never cache index.html so new deployments are always picked up immediately.
    location = /index.html {
        include /etc/nginx/finco-security-headers.conf;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        try_files $uri =404;
    }

    # No error-log request URI for incoming recovery credentials.
    location ~ ^/(reset-password|verify-email)$ {
        error_log /dev/null;
        try_files /index.html =404;
    }

    # Machine-readable endpoints must never fall through to the SPA shell.
    location = /robots.txt { default_type text/plain; try_files $uri =404; }
    location = /llms.txt { default_type text/plain; try_files $uri =404; }
    location = /.well-known/ai-catalog.json { default_type application/json; try_files $uri =404; }
    location = /ai-catalog.json { default_type application/json; try_files /.well-known/ai-catalog.json =404; }

    # Do not answer missing module/source requests with HTML.
    location ~ ^/(static|src|node_modules)/ { try_files $uri =404; }
    location = /@vite/client { return 404; }
    location = /.vite/manifest.json { return 404; }

    # SPA fallback — serve index.html for all non-file routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
