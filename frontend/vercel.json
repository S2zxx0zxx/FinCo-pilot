{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.fincopilot.app/api/:path*"
    },
    {
      "source": "/welcome",
      "destination": "/welcome/index.html"
    },
    {
      "source": "/ai-catalog.json",
      "destination": "/.well-known/ai-catalog.json"
    },
    {
      "source": "/((?!welcome(?:/|$)|api(?:/|$)|mcp(?:/|$)|static(?:/|$)|src(?:/|$)|node_modules(?:/|$)|@vite(?:/|$)|\\.vite(?:/|$)|\\.well-known(?:/|$)|sitemap\\.xml$|robots\\.txt$|llms\\.txt$).*)",
      "destination": "/index.html"
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(reset-password|verify-email|sso-callback|sign-up)(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/welcome/",
      "permanent": true
    },
    {
      "source": "/features",
      "destination": "/welcome/features/",
      "permanent": true
    },
    {
      "source": "/how-it-works",
      "destination": "/welcome/how-it-works/",
      "permanent": true
    },
    {
      "source": "/guides/import-transactions",
      "destination": "/welcome/guides/import-transactions/",
      "permanent": true
    },
    {
      "source": "/welcome/",
      "has": [
        {
          "type": "host",
          "value": "www.fincopilot.app"
        }
      ],
      "destination": "https://fincopilot.app/welcome/",
      "permanent": true
    },
    {
      "source": "/welcome/features/",
      "has": [
        {
          "type": "host",
          "value": "www.fincopilot.app"
        }
      ],
      "destination": "https://fincopilot.app/welcome/features/",
      "permanent": true
    },
    {
      "source": "/welcome/how-it-works/",
      "has": [
        {
          "type": "host",
          "value": "www.fincopilot.app"
        }
      ],
      "destination": "https://fincopilot.app/welcome/how-it-works/",
      "permanent": true
    },
    {
      "source": "/welcome/guides/import-transactions/",
      "has": [
        {
          "type": "host",
          "value": "www.fincopilot.app"
        }
      ],
      "destination": "https://fincopilot.app/welcome/guides/import-transactions/",
      "permanent": true
    },
    {
      "source": "/welcome/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.fincopilot.app"
        }
      ],
      "destination": "https://fincopilot.app/welcome/:path*",
      "permanent": true
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "www.fincopilot.app"
        }
      ],
      "destination": "https://fincopilot.app/robots.txt",
      "permanent": true
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "www.fincopilot.app"
        }
      ],
      "destination": "https://fincopilot.app/sitemap.xml",
      "permanent": true
    }
  ]
}
