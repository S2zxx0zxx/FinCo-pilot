{
  "name": "FinCo-Pilot",
  "short_name": "FinCo",
  "description": "Privacy-first personal finance, budgets, goals, assets, invoices and insights in one fast workspace.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "lang": "en-IN",
  "dir": "ltr",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["finance", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/android-icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "url": "/",
      "icons": [{ "src": "/android-icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Transactions",
      "short_name": "Transactions",
      "url": "/transactions",
      "icons": [{ "src": "/android-icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Accounts",
      "short_name": "Accounts",
      "url": "/accounts",
      "icons": [{ "src": "/android-icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Reports",
      "short_name": "Reports",
      "url": "/reports",
      "icons": [{ "src": "/android-icon-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
