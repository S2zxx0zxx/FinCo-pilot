# Copy to .env on the OmniRoute VPS. Never commit the real .env.
#
# Stable production image pinned intentionally. Review upstream release notes,
# then change this exact tag deliberately when upgrading.
OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.50

# Host loopback ports. Public traffic should enter through TLS reverse proxy.
OMNIROUTE_DASHBOARD_PORT=20128
OMNIROUTE_API_PORT=20129

# Backpressure for the initial FinCo-Pilot launch. Tune from real p95 latency,
# VPS CPU/RAM, and provider rate limits rather than raising blindly.
OMNI_MAX_CONCURRENT_CONNECTIONS=16

# Generate:
#   openssl rand -base64 48
JWT_SECRET=

# Generate:
#   openssl rand -hex 32
API_KEY_SECRET=

# Generate a long unique password; rotate it after first dashboard login.
INITIAL_PASSWORD=

# Required by OmniRoute's production Docker posture for the WS bridge.
# Generate:
#   openssl rand -hex 32
OMNIROUTE_WS_BRIDGE_SECRET=

# Encrypts OmniRoute's persisted SQLite data at rest.
# Generate:
#   openssl rand -hex 32
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# REQUIRE_API_KEY is forced true in docker-compose.yml and is intentionally
# not configurable here. FinCo-Pilot must use a dedicated OmniRoute API key.
